{
  "name": "fitmap",
  "version": "1.0.0",
  "description": "Aplicativo para localizar academias próximas, comparar opções e registrar exercícios concluídos.",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "jest": {
    "preset": "jest-expo"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --clear",
    "start:lan": "expo start --lan --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "clear": "expo start --clear",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write src/**/*.{ts,tsx} app.json package.json tsconfig.json eslint.config.js",
    "format:check": "prettier --check src/**/*.{ts,tsx} app.json package.json tsconfig.json eslint.config.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "58.0.20",
    "expo-camera": "58.0.13",
    "expo-file-system": "58.0.12",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.19",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "lucide-react-native": "^1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.2.0",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.8",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-devtools-core": {
      "shell-quote": "1.11.0",
      "ws": "7.5.11"
    },
    "react-native": {
      "ws": "7.5.11"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    }
  }
}
