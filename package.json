{
  "name": "fitmap",
  "version": "1.0.0",
  "description": "Aplicativo para localizar academias próximas, comparar opções e registrar exercícios concluídos.",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --clear",
    "start:lan": "expo start --lan --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "clear": "expo start --clear",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write src/**/*.{ts,tsx} app.json package.json tsconfig.json eslint.config.js",
    "format:check": "prettier --check src/**/*.{ts,tsx} app.json package.json tsconfig.json eslint.config.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo": "^57.0.9",
    "expo-camera": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-location": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  }
}
