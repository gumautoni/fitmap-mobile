# FitMap backend environment
FITMAP_ENVIRONMENT=development
FITMAP_LOG_LEVEL=INFO

# PostgreSQL local development
FITMAP_DB_HOST=127.0.0.1
FITMAP_DB_PORT=5433
FITMAP_DB_NAME=fitmap
FITMAP_DB_USER=fitmap
FITMAP_DB_PASSWORD=change-me-local

# Authentication
FITMAP_AUTH_JWT_SECRET=replace-with-a-strong-random-secret
FITMAP_AUTH_JWT_ALGORITHM=HS256
FITMAP_AUTH_JWT_ISSUER=fitmap-api
FITMAP_AUTH_JWT_AUDIENCE=fitmap-mobile
FITMAP_AUTH_ACCESS_TOKEN_MINUTES=15
FITMAP_AUTH_REFRESH_TOKEN_DAYS=30
# Recovery is disabled until email verification and the delivery provider are implemented.
# Create an independent 32+ character random secret; never use the JWT signing secret.
# FITMAP_AUTH_RECOVERY_CODE_SECRET=replace-with-an-independent-strong-random-secret

# Separate 32+ byte secret for email ownership verification, not needed until enabled.
# FITMAP_AUTH_EMAIL_VERIFICATION_SECRET=replace-with-another-independent-strong-random-secret

# Transactional email stays disabled until delivery and HTTP controls are ready.
FITMAP_EMAIL_PROVIDER=disabled
FITMAP_EMAIL_TIMEOUT_SECONDS=5.0
# FITMAP_RESEND_API_KEY=replace-with-a-server-only-secret
# FITMAP_EMAIL_FROM_ADDRESS=nao-responda@SEU-DOMINIO-VERIFICADO
# Independent 32-byte Fernet key (urlsafe base64); generate via Fernet.generate_key().
# Required when queuing emails, not for normal app startup. NEVER put the real key in Git.
# FITMAP_EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-independent-fernet-key

# Geoapify gym provider
FITMAP_GEOAPIFY_API_KEY=replace-with-geoapify-api-key
FITMAP_GEOAPIFY_TIMEOUT_SECONDS=5.0

# Private media storage
FITMAP_MEDIA_BUCKET_NAME=fitmap-private-media
FITMAP_MEDIA_REGION_NAME=us-east-1
FITMAP_MEDIA_ENDPOINT_URL=http://127.0.0.1:9090
FITMAP_MEDIA_ACCESS_KEY_ID=test
FITMAP_MEDIA_SECRET_ACCESS_KEY=test
FITMAP_MEDIA_PORT=9090
