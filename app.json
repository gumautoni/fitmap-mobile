{
  "expo": {
    "name": "FitMap",
    "slug": "fitmap",
    "description": "Aplicativo para localizar academias próximas, comparar opções e registrar exercícios concluídos.",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "fitmap",
    "icon": "./assets/images/logo-fitmap.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-fitmap.png",
          "resizeMode": "contain",
          "backgroundColor": "#111827",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o FitMap acesse sua localização para encontrar academias próximas."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "android": {
      "package": "com.bryan.fitmap",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-fitmap.png",
        "backgroundColor": "#111827"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bryan.fitmap",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permita que o FitMap acesse sua localização para encontrar academias próximas."
      }
    }
  }
}
